# 目标芯片：ESP32-C3
CONFIG_IDF_TARGET="esp32c3"

# 桥接 UART 引脚：TX=GPIO4, RX=GPIO5
# 避开 ESP32-C3 的 strapping 引脚 GPIO2/GPIO8/GPIO9：
# GPIO8 常接板载 LED、GPIO9 接 BOOT 按键，用作 UART 会导致接收方向被干扰。
# 代价：GPIO4/GPIO5 是 JTAG 脚，本工程不需要 JTAG 调试。
CONFIG_BRIDGE_UART_TX=4
CONFIG_BRIDGE_UART_RX=5

# 蓝牙控制器 BLE-only + NimBLE 主机栈（比 Bluedroid 更省内存）
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# BLE 默认发射功率：本板 3.0V 供电，高功率档实际输出会衰减、峰值电流也更
# 容易把电源拉低，故默认取 +3dBm（兼顾距离与电源裕量）。
# 运行时还可用控制命令 POWER=<dBm> 动态调整（见 main.c）。
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P9=n
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P3=y

# 尽量争取大 MTU；ble_uart_tx 会按实际 MTU 自动分片，
# 接收方向组件也会自动重组长写（PREP/EXEC）。
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512

# 收发缓冲加大：网页端现在会“在途多包”流水线写入（BLE_WRITE_PIPELINE），
# 更大缓冲可吸收突发、降低 DROP。ESP32-C3 内存充裕，8192 足够。
CONFIG_BRIDGE_BUF_SIZE=8192

# BLE 发射功率上限：3.0V 供电下高功率会导致电源跌落、链路监督超时(0x208)，
# 运行期 POWER 命令默认最多只能设到 +9dBm。
CONFIG_BRIDGE_TX_POWER_MAX_DBM=9

# 只做外设(GATT Server)，关掉用不到的角色以节省 flash/RAM。
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# 注意：本工程采用“明文、免配对”模式(ble_uart_config_t.encrypted = false)，
# 因此不开启 SM_SC / NVS_PERSIST；如需加密绑定请在此追加：
#   CONFIG_BT_NIMBLE_SM_SC=y
#   CONFIG_BT_NIMBLE_NVS_PERSIST=y
# 并把 main.c 里的 .encrypted 改为 true。
